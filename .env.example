# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only secret. Never expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mercado Pago Developers > Your integrations > Credentials (production access token)
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token

# Public URL of the deployed site (used for Mercado Pago back/notification urls)
NEXT_PUBLIC_SITE_URL=https://stefaniejonatas.site
